# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/campus-marketplace?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────
JWT_SECRET=replace_this_with_a_random_64_character_string_minimum
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Domain Restriction ───────────────────
# Only emails from this domain can log in
# Change to your college domain e.g. mgit.ac.in
ALLOWED_DOMAINS=mgit.ac.in

# ── Cloudinary ───────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Keys (at least one required for AI features) ──
# Get Gemini free at: https://aistudio.google.com
GEMINI_API_KEY=AIza_your_gemini_key

# Optional: OpenAI (used instead of Gemini if both present)
# OPENAI_API_KEY=sk-your_openai_key

# ── Frontend URL (for CORS) ──────────────
CLIENT_URL=https://your-app.vercel.app
